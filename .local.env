# Template of the environment variables used by relay-backend.
#
# Usage:
#   cp .local.env .env
#   # fill in the values below
#
# .env is gitignored. Never commit real credentials.

# ── Better Auth ──────────────────────────────────────────────────────────────
# Secret used to sign sessions and cookies. Generate one with:
#   openssl rand -base64 32
# Docs: https://www.better-auth.com/docs/installation#set-environment-variables
BETTER_AUTH_SECRET=

# Public base URL of this backend, without a trailing slash.
# Used by Better Auth to build callback/redirect URLs, e.g. http://localhost:3000
BETTER_AUTH_URL=

# ── Google Sheets ────────────────────────────────────────────────────────────
# ID of the spreadsheet to read/import. It is the long string in the sheet URL:
#   https://docs.google.com/spreadsheets/d/<GOOGLE_SPREADSHEET_ID>/edit
# The service account in relay-test-credentials.json must be shared on the sheet.
GOOGLE_SPREADSHEET_ID=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Consumed by docker-compose.yml to start the local database:
#   docker compose up -d postgres
# Any local values work, but DATABASE_URL below must match them.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASS=

# Connection string used by the app and Drizzle:
#   postgresql://<POSTGRES_USER>:<POSTGRES_PASS>@localhost:5432/<POSTGRES_DB>
DATABASE_URL=

# ── Redis (reserved) ─────────────────────────────────────────────────────────
# Not read by the code yet; kept for the worker/queue setup.
# Local Redis: redis://localhost:6379
# Hosted: copy the connection string from your provider (Upstash, Railway, etc.).
REDIS_URL=
# Password for Redis, when the instance requires auth. Leave empty for local Redis.
REDIS_PASS=

# ── Worker flag (reserved) ───────────────────────────────────────────────────
# Not read by the code yet; intended to enable/disable the background worker.
RUN_WORKER=

# ── Resend (organization invitation emails) ──────────────────────────────────
# 1. Create a free account: https://resend.com
# 2. Create an API key:    https://resend.com/api-keys
# The key starts with "re_" — paste it here.
RESEND_KEY=

# Optional sender address. Until you verify a domain at
# https://resend.com/domains, Resend only allows the shared onboarding@resend.dev
# sender and only delivers to the Resend account owner's address.
# After verifying your domain, uncomment and adjust:
# RESEND_FROM="Relay <no-reply@yourdomain.com>"
